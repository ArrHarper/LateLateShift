{% extends 'base.njk' %}
{% from "_components/ui.njk" import pageHero, secHead, mod %}
{% from "_components/llsTable.njk" import llsTable %}
{% from "_components/callout.njk" import callout %}

{% block title %}LLS Rules 🏈 The Late Late Shift{% endblock %}

{% block content %}
{{ pageHero(
    "Rules & Scoring",
    intro="League constitution: format, rosters, scoring, and the keeper system.",
    updated="8/14/26",
    image="https://embed-ssl.wistia.com/deliveries/7f048c1d12339c4d715848e521c17696.png",
    imageAlt="Overhead view of Gillette Stadium"
) }}

<div class="rules-grid">
    <div class="rules-col">

        <div id="r-general">
            {{ secHead("General") }}
            <div class="fact-tiles">
                <div class="fact"><div class="cap">Format</div><div class="val">0.5 PPR</div></div>
                <div class="fact"><div class="cap">Teams</div><div class="val">10</div></div>
                <div class="fact"><div class="cap">Draft</div><div class="val">Snake <small>randomized</small></div></div>
                <div class="fact"><div class="cap">Buy-in</div><div class="val">${{ league.current.buyIn }}</div></div>
                <div class="fact"><div class="cap">Payouts</div><div class="val">${{ league.current.payoutChampion }} / ${{ league.current.payoutRunnerUp }} <small>SB win / loss</small></div></div>
            </div>
        </div>

        <div id="r-roster">
            {{ secHead("Roster") }}
            <p class="prose">Standard roster with a dedicated TE slot and a W/R/T flex.</p>
            <div class="slot-chips">
                <span class="slot slot-qb">QB<i>1</i></span>
                <span class="slot slot-rb">RB<i>2</i></span>
                <span class="slot slot-wr">WR<i>3</i></span>
                <span class="slot slot-te">TE<i>1</i></span>
                <span class="slot slot-flex">W/R/T<i>1</i></span>
                <span class="slot slot-k">K<i>1</i></span>
                <span class="slot slot-dst">DST<i>1</i></span>
                <span class="slot bench">BN<i>6</i></span>
                <span class="slot bench">IR<i>2</i></span>
            </div>
        </div>

        <div id="r-offense">
            {{ secHead("Offensive Scoring", color="blue") }}
            <p class="prose">0.5 PPR; INTs and fumbles carry the same penalty, otherwise Yahoo default.</p>
            <div class="lls-table-row">
                {{ llsTable({
                    columns: [{ label: "Touchdowns" }, { label: "Pts", type: "num" }],
                    rows: [["Pass TD", "4"], ["Rush TD", "6"], ["Rec TD", "6"]]
                }) }}
                {{ llsTable({
                    columns: [{ label: "Yardage" }, { label: "Pts", type: "num" }],
                    rows: [["Pass yard", "0.04"], ["Rush yard", "0.1"], ["Rec yard", "0.1"]]
                }) }}
                {{ llsTable({
                    columns: [{ label: "Turnovers" }, { label: "Pts", type: "num" }],
                    rows: [["Fumble", "−2.0"], ["INT", "−2.0"]]
                }) }}
            </div>
        </div>

        <div id="r-defense">
            {{ secHead("Defensive Scoring", color="blue") }}
            <p class="prose">We use modified defensive scoring to better represent the in-game impact of a
            defense. The main goal is to reduce the chance that a defense can score big in fantasy while
            getting destroyed in real life. The first few scores against a defense have a smaller penalty,
            later scores have a greater penalty, and the overall max penalty for points allowed is
            increased. There is also an added penalty for 400 and 500 yards allowed.</p>
            {{ callout(type='info', content='The max penalty for a DST is <b>−7 pts</b> (35 pts and 500+ yards allowed).') }}
            <div class="lls-table-row">
                {{ llsTable({
                    columns: [{ label: "DST Pts Allowed" }, { label: "Pts", type: "num" }],
                    rows: [
                        ["Allowed 0", "10"],
                        ["Allowed 1–6", "9"],
                        ["Allowed 7–13", "7"],
                        ["Allowed 14–20", "4"],
                        ["Allowed 21–27", "1"],
                        ["Allowed 28–34", "−2"],
                        ["Allowed 35+", "−5"]
                    ]
                }) }}
                {{ llsTable({
                    columns: [{ label: "DST Yds Allowed" }, { label: "Pts", type: "num" }],
                    rows: [["Yds Allowed 400–499", "−1"], ["Yds Allowed 500+", "−2"]]
                }) }}
                {{ llsTable({
                    columns: [{ label: "Other Plays" }, { label: "Pts", type: "num" }],
                    rows: [
                        ["Sack", "1"],
                        ["4th Down Stop", "1*"],
                        ["Fumble Rec", "2"],
                        ["Interception", "2"],
                        ["Touchdown", "6"],
                        ["Safety", "2"],
                        ["Kick/Punt Return TD", "6"]
                    ]
                }) }}
            </div>
            <p class="tbl-note">* Increased from 0</p>
        </div>

        <div id="r-keepers">
            {{ secHead("Keeper Rules", color="red") }}
            <ul class="rule-list">
                <li>Up to <b>2 keepers</b> per team — keeping players is optional.</li>
                <li><b>Players drafted in Round 1 cannot be kept.</b> This keeps a healthy pool of elite players in the draft mix each year.</li>
                <li>The same player can only be kept for <b>two consecutive seasons</b>, at which point they return to the draft pool.</li>
            </ul>
        </div>

        <div id="r-costs">
            {{ secHead("Keeper Costs", color="red") }}
            <p class="prose">The cost to keep a player depends on if and where they were last drafted.</p>
            <ul class="rule-list">
                <li>Keeper cost equals the player's <b>most recent draft position</b> — a player selected in round 4 in 2021 costs a 4th-round pick to keep in 2022.</li>
                <li><b>Keeping a player a second consecutive season costs one round more</b> — that 4th-round selection now costs a 3rd-round pick.</li>
                <li>Any player not in the most recent draft is a <b>UDFA</b>: an <b>8th-round pick</b> the first year, a <b>7th-round pick</b> the second.</li>
            </ul>
            <div class="example">
                <div class="cap">Example · drafted player</div>
                <ol>
                    <li>2020 — Mark Andrews drafted in round 6</li>
                    <li>2021 — Andrews costs a 6th-round pick to keep</li>
                    <li>2022 — Andrews costs a 5th-round pick to keep again</li>
                    <li>2023 — Andrews returns to the draft pool</li>
                </ol>
            </div>
            <div class="example">
                <div class="cap">Example · UDFA</div>
                <ol>
                    <li>2020 — Justin Jefferson acquired as a UDFA</li>
                    <li>2021 — Jefferson costs an 8th-round pick to keep</li>
                    <li>2022 — Jefferson costs a 7th-round pick to keep again</li>
                    <li>2023 — Jefferson returns to the draft pool</li>
                </ol>
            </div>
        </div>

        <div id="r-faq" class="faq">
            {{ secHead("Keeper FAQ", color="red") }}
            <h3>What if I want to keep two UDFAs, or two players drafted in the same round?</h3>
            <p>The cost for the second keeper increases by one round. Keeping two UDFAs costs an 8th and a
            7th; keeping two players drafted in the 10th round costs a 10th and a 9th.</p>
            <h3>If I only keep a player for one season, can I pick him again in the draft?</h3>
            <p>Yes — once a player returns to the draft pool, drafting him back onto your roster resets
            his keeper costs.</p>
        </div>

    </div>

    <div class="mod toc-mod">
        <div class="mod-head"><h3>On this page</h3></div>
        <ol>
            <li><a href="#r-general">General</a></li>
            <li><a href="#r-roster">Roster</a></li>
            <li><a href="#r-offense">Offensive Scoring</a></li>
            <li><a href="#r-defense">Defensive Scoring</a></li>
            <li><a href="#r-keepers">Keeper Rules</a></li>
            <li><a href="#r-costs">Keeper Costs</a></li>
            <li><a href="#r-faq">Keeper FAQ</a></li>
        </ol>
    </div>
</div>
{% endblock %}
