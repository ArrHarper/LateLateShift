{% extends 'base.njk' %}
{% from "_components/ui.njk" import secHead, mod %}
{% from "_components/llsTable.njk" import llsTable %}

{% block title %}LLS 🏈 The Late Late Shift{% endblock %}

{% block content %}
{% set current = league.current %}
{% set champSeason = league.seasons | last %}
{% set latestKeepers = keepers.seasons | first %}

<div class="hero-panel">
    <div class="hero-main">
        <div class="kicker">Season Preview</div>
        <h1>Welcome back for the {{ current.year }} season</h1>
        <p class="dek">Year {{ current.seasonNo }} of never being late, always right on time. The draft
        is around the corner — review last season's results, scout the keeper board, and lock your two
        before the deadline.</p>
        <div class="byline">From the Commissioner's Desk</div>
        <a class="btn-primary" href="https://football.fantasysports.yahoo.com/f1/{{ current.leagueId }}/1/keepers" target="_blank" rel="noopener">Select Your Keepers</a>
        <a class="link-strong" href="https://football.fantasysports.yahoo.com/{{ current.priorYear }}/f1/{{ current.priorLeagueId }}/draftresults" target="_blank" rel="noopener">{{ current.priorYear }} Draft Results →</a>
    </div>
    <div class="hero-wing">
        <div class="cap"><span class="dot"></span> Time til Football</div>
        <div class="clock" id="hero-countdown" data-target="{{ current.kickoff }}">—</div>
        <div class="sub">{{ current.kickoffMatchup }} · {{ current.kickoffDisplay }}</div>
        <div class="dl">Trade deadline <b>{{ current.tradeDeadline }}</b> · Playoffs <b>Wks {{ current.playoffWeeks }}</b></div>
    </div>
</div>

<div class="trio">
    {% call mod("Reigning Champ", link=('/recordBook/' | url), linkText="Hall of Records →") %}
    <div class="champ-bd">
        <div class="ava">{% if champSeason.champion.avatar %}<img src="{{ champSeason.champion.avatar | url }}" alt="">{% else %}{{ champSeason.champion.manager | truncate(2, true, '') }}{% endif %}</div>
        <p><b>{{ champSeason.champion.team }}</b> 🏆 {{ [champSeason.year] | shortYears }}<br>
        <span>{{ champSeason.champion.manager }} · def. {{ champSeason.runnerUp.team }} · {{ champSeason.champion.score }}–{{ champSeason.runnerUp.score }}</span></p>
    </div>
    {% endcall %}

    {% call mod("Yahoo Quick Links") %}
    <div class="link-list">
        <a href="https://football.fantasysports.yahoo.com/{{ current.priorYear }}/f1/{{ current.priorLeagueId }}/draftresults" target="_blank" rel="noopener">{{ current.priorYear }} Draft Results <span>→</span></a>
        <a href="https://football.fantasysports.yahoo.com/{{ current.priorYear }}/f1/{{ current.priorLeagueId }}/starters" target="_blank" rel="noopener">{{ current.priorYear }} Final Rosters <span>→</span></a>
        <a href="https://football.fantasysports.yahoo.com/f1/{{ current.leagueId }}/1/keepers" target="_blank" rel="noopener">Select {{ current.year }} Keepers <span>→</span></a>
    </div>
    {% endcall %}

    {% call mod("The Pot", link=('/rules/' | url), linkText="Rules →") %}
    <ul class="kv-list">
        <li><span class="k">Buy-in</span><span class="v">${{ current.buyIn }}</span></li>
        <li><span class="k">Champion</span><span class="v">${{ current.payoutChampion }}</span></li>
        <li><span class="k">Runner-up</span><span class="v">${{ current.payoutRunnerUp }}</span></li>
    </ul>
    {% endcall %}
</div>

<div>
    {% set nextYear = latestKeepers.year + 1 %}
    {{ secHead("Keeper Outlook " + ([nextYear] | shortYears), note="who can be kept again, and what it costs", link=('/keeper-history/' | url), linkText="Full history →") }}
    {% set outlook = latestKeepers.rows | keeperOutlook %}
    <div class="split-main-rail outlook-grid">
        {% set outlookRows = [] %}
        {# default order: cheapest '26 keeps first, back-to-pool rows last #}
        {% set eligRows = outlook | selectattr("eligible") | sort(false, false, "nextCost") | list %}
        {% set poolRows = outlook | rejectattr("eligible") | list %}
        {% for k in eligRows.concat(poolRows) %}
            {% set _ = outlookRows.push([
                k.manager,
                k.player,
                k.pos,
                k.cost,
                ("Rd " + k.nextCost) if k.eligible else "—",
                ('<span class="cell-ok">Eligible</span>' if k.eligible else '<span class="cell-out">Back to pool</span>')
            ]) %}
        {% endfor %}
        <div class="outlook-holder">
        {{ llsTable({
            columns: [
                { label: "Manager", type: "text", strong: true },
                { label: ([latestKeepers.year] | shortYears) + " Keeper", type: "text" },
                { label: "POS", type: "text" },
                { label: ([latestKeepers.year] | shortYears) + " Cost", type: "num", hideMobile: true },
                { label: ([nextYear] | shortYears) + " Cost", type: "num" },
                { label: "Status", type: "text" }
            ],
            rows: outlookRows
        }, sortable=true, id='keeper-outlook') }}
        </div>
        <div class="mod rank-mod">
            <div class="mod-head"><h3>Back in the Pool · {{ nextYear }}</h3></div>
            <ol>
                {% for k in outlook %}
                {% if not k.eligible %}
                <li>
                    <span class="who"><b>{{ k.player }}</b><span>kept 2 yrs by {{ k.manager }}</span></span>
                    <span class="pill pill-red">{{ k.pos }}</span>
                </li>
                {% endif %}
                {% endfor %}
            </ol>
        </div>
    </div>
</div>

<div>
    {{ secHead("League News", color="red") }}
    <div class="mod news-list">
        {% for item in news %}
        {% if loop.index <= 3 %}
        <a{% if item.href %} href="{{ item.href | url }}"{% endif %}>
            <span class="tag tag-{{ item.tag }}">{{ item.tag }}</span>
            <b>{{ item.title }}</b>
            <time datetime="{{ item.date }}">{{ item.date | newsDate }}</time>
        </a>
        {% endif %}
        {% endfor %}
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>(function(){var el=document.getElementById('hero-countdown');if(!el)return;var targetMs=Date.parse(el.dataset.target);function pad(n){return String(n).padStart(2,'0');}function tick(){var diff=targetMs-Date.now();if(diff<=0){el.textContent='Kickoff time!';clearInterval(t);return;}var d=Math.floor(diff/864e5),h=Math.floor(diff%864e5/36e5),m=Math.floor(diff%36e5/6e4),s=Math.floor(diff%6e4/1e3);el.textContent=d+'d '+pad(h)+'h '+pad(m)+'m '+pad(s)+'s';}tick();var t=setInterval(tick,1000);}());</script>
{% endblock %}
