{% extends 'base.njk' %}
{% from "_components/ui.njk" import secHead, mod %}

{% block title %}LLS 🏈 The Late Late Shift{% endblock %}

{% block content %}
{% set current = league.current %}
{% set champSeason = league.seasons | last %}

<div class="hero-panel">
    <div class="hero-main">
        <div class="kicker">Season Seven</div>
        <h1>Welcome back for the {{ current.year }} season</h1>
        <p class="dek">Year {{ current.seasonNo }} of never being late, always right on time.</p>
        <div class="byline">From the Commissioner's Desk</div>
        <a class="btn-primary" href="{{ '/draft/' | url }}">Draft Central</a>
    </div>
    <div class="hero-wing">
        <div class="cap"><span class="dot"></span> Time til Football</div>
        <div class="clock" id="hero-countdown" data-target="{{ current.kickoff }}">—</div>
        <div class="sub">{{ current.kickoffMatchup }} · {{ current.kickoffDisplay }}</div>
        <div class="dl">Trade deadline <b>{{ current.tradeDeadline }}</b> · Playoffs <b>Wks {{ current.playoffWeeks }}</b></div>
    </div>
</div>

<div class="trio">
    {% call mod("Reigning Champ", link=('/recordBook/' | url), linkText="Hall of Records →") %}
    <div class="champ-bd">
        <div class="ava">{% if champSeason.champion.avatar %}<img src="{{ champSeason.champion.avatar | url }}" alt="">{% else %}{{ champSeason.champion.manager | truncate(2, true, '') }}{% endif %}</div>
        <p><b>{{ champSeason.champion.team }}</b> 🏆 {{ [champSeason.year] | shortYears }}<br>
        <span>{{ champSeason.champion.manager }} · def. {{ champSeason.runnerUp.team }} · {{ champSeason.champion.score }}–{{ champSeason.runnerUp.score }}</span></p>
    </div>
    {% endcall %}

    {% call mod("Yahoo Quick Links") %}
    <div class="link-list">
        <a href="https://football.fantasysports.yahoo.com/f1/{{ current.leagueId }}" target="_blank" rel="noopener">{{ current.year }} League Home · Matchups <span>→</span></a>
        <a href="https://football.fantasysports.yahoo.com/f1/{{ current.leagueId }}/standings" target="_blank" rel="noopener">{{ current.year }} Standings <span>→</span></a>
        <a href="https://football.fantasysports.yahoo.com/f1/{{ current.leagueId }}/draftresults" target="_blank" rel="noopener">{{ current.year }} Draft Results <span>→</span></a>
    </div>
    {% endcall %}

    {% call mod("The Pot", link=('/rules/' | url), linkText="Rules →") %}
    <ul class="kv-list">
        <li><span class="k">Buy-in</span><span class="v">${{ current.buyIn }}</span></li>
        <li><span class="k">Champion</span><span class="v">${{ current.payoutChampion }}</span></li>
        <li><span class="k">Runner-up</span><span class="v">${{ current.payoutRunnerUp }}</span></li>
    </ul>
    {% endcall %}
</div>

{# ---------- post-draft power rankings (draftGrades.json, newest season first) ---------- #}
{% set grades = draftGrades.seasons | first %}
<div>
    {{ secHead(grades.year + " Post-Draft Power Rankings", link=(grades.recapPath | url), linkText="All grades & recaps →") }}
    <div class="mod rank-mod grade-board">
        <ol>
            {% for r in grades.rows %}
            <li>
                <span class="rk">{{ r.rank }}</span>
                <a class="face" href="{{ (grades.recapPath + 'recap-' + r.slug + '-' + grades.year + '.html') | url }}"><img src="{{ r.avatar | url }}" alt=""></a>
                <span class="who"><a href="{{ (grades.recapPath + 'recap-' + r.slug + '-' + grades.year + '.html') | url }}"><b>{{ r.team }}</b></a><span>{{ r.manager }} · Pick {{ r.draftSlot }}</span></span>
                <span class="hook">{{ r.boardLine }}</span>
                <span class="grade-pill {{ 'g-good' if r.grade in ['A','A-'] else ('g-mid' if r.grade in ['B+','B','B-'] else 'g-bad') }}">{{ r.grade }}</span>
            </li>
            {% endfor %}
        </ol>
    </div>
</div>

<div>
    {{ secHead("League News", color="red") }}
    <div class="mod news-list">
        {% for item in news %}
        {% if loop.index <= 3 %}
        <a{% if item.href %} href="{{ item.href | url }}"{% endif %}>
            <span class="tag tag-{{ item.tag }}">{{ item.tag }}</span>
            <b>{{ item.title }}</b>
            <time datetime="{{ item.date }}">{{ item.date | newsDate }}</time>
        </a>
        {% endif %}
        {% endfor %}
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>(function(){var el=document.getElementById('hero-countdown');if(!el)return;var targetMs=Date.parse(el.dataset.target);function pad(n){return String(n).padStart(2,'0');}function tick(){var diff=targetMs-Date.now();if(diff<=0){el.textContent='Kickoff time!';clearInterval(t);return;}var d=Math.floor(diff/864e5),h=Math.floor(diff%864e5/36e5),m=Math.floor(diff%36e5/6e4),s=Math.floor(diff%6e4/1e3);el.textContent=d+'d '+pad(h)+'h '+pad(m)+'m '+pad(s)+'s';}tick();var t=setInterval(tick,1000);}());</script>
{% endblock %}
