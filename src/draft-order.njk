{% extends 'base.njk' %}
{% from "_components/ui.njk" import pageHero, secHead %}

{% block title %}LLS Draft Order 🏈 The Late Late Shift{% endblock %}

{% block head %}
<script src="https://fast.wistia.com/player.js" async></script>
{% for video in draftVideos %}
<script src="https://fast.wistia.com/embed/{{ video.wistiaId }}.js" async type="module"></script>
<style>wistia-player[media-id='{{ video.wistiaId }}']:not(:defined) { background: center / contain no-repeat url('https://fast.wistia.com/embed/medias/{{ video.wistiaId }}/swatch'); display: block; filter: blur(5px); padding-top: 56.25%; }</style>
{% endfor %}
{% endblock %}

{% block content %}
{{ pageHero(
    "Draft Order Reveals",
    intro="Each season's draft order, revealed the only way we know how: unnecessarily produced videos.",
    updated="Aug 2026"
) }}

{% for video in draftVideos %}
<div class="draft-section">
    <div class="mod-head"><h3>{{ video.year }} Draft Order</h3></div>
    <div class="bd">
        <p>{{ video.blurb }}</p>
        <div class="draft-video">
            <wistia-player media-id="{{ video.wistiaId }}" seo="false" aspect="1.7777777777777777"></wistia-player>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}
