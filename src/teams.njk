{% extends 'base.njk' %}
{% from "_components/ui.njk" import pageHero, secHead %}
{% from "_components/llsTable.njk" import llsTable %}

{% block title %}LLS Teams &amp; Managers 🏈 The Late Late Shift{% endblock %}

{% block content %}
{{ pageHero(
    "Teams & Managers",
    intro="All-time stats per manager across " + (league.seasons | length | string) + " seasons. Click column headers to sort.",
    updated="Aug 13, 2026",
    image="https://embed-ssl.wistia.com/deliveries/04b18769145f242f5e8dd0c80982d736.png",
    imageAlt="Patriots players dump a water cooler over Bill Belichick to celebrate"
) }}

<div class="duo">
    <div>
        {{ secHead("Title Count", link=('/recordBook/' | url), linkText="Records →") }}
        {% set titleRows = [] %}
        {% for t in teams | sort(true, false, 'winPct') | sort(true, false, 'titles.count') %}
            {% if t.titles.count > 0 %}
                {% set _ = titleRows.push(["<b>" + t.manager + "</b>", t.titles.count, t.titles.years | shortYears]) %}
            {% endif %}
        {% endfor %}
        {{ llsTable({
            columns: [
                { label: "Manager", type: "text" },
                { label: "🏆", type: "num" },
                { label: "Years Won", type: "text" }
            ],
            rows: titleRows
        }, id='title-count') }}
    </div>
    <div>
        {{ secHead("Superlatives", color="red") }}
        {% set byWin = teams | sort(true, false, 'winPct') | first %}
        {% set byPf = teams | sort(true, false, 'pfAvg') | first %}
        {% set byPa = teams | sort(true, false, 'paAvg') | first %}
        {% set byMoves = teams | sort(true, false, 'moves') | first %}
        {% set byFewMoves = teams | sort(false, false, 'moves') | first %}
        {{ llsTable({
            columns: [
                { label: "Superlative", type: "text" },
                { label: "Manager", type: "text" },
                { label: "Value", type: "num" }
            ],
            rows: [
                ["Best win %", "<b>" + byWin.manager + "</b>", byWin.winPct | pct3],
                ["Highest PF avg", "<b>" + byPf.manager + "</b>", byPf.pfAvg | num2],
                ["Highest PA avg", "<b>" + byPa.manager + "</b>", byPa.paAvg | num2],
                ["Most moves", "<b>" + byMoves.manager + "</b>", byMoves.moves],
                ["Fewest moves", "<b>" + byFewMoves.manager + "</b>", byFewMoves.moves]
            ]
        }, id='superlatives') }}
    </div>
</div>

<div>
    {{ secHead("All-Time Standings", color="blue", note=(league.seasons | first).year + "–" + (league.seasons | last).year + " · click headers to sort") }}
    {% set standingsRows = [] %}
    {% for t in teams | sort(true, false, 'winPct') %}
        {% set _ = standingsRows.push([
            t.manager,
            t.titles.count if t.titles.count > 0 else "",
            t.years,
            t.wins,
            t.losses,
            t.winPct | pct3,
            t.pf | num2,
            t.pa | num2,
            t.pfAvg | num2,
            t.paAvg | num2,
            t.moves,
            t.movesAvg | num2
        ]) %}
    {% endfor %}
    {{ llsTable({
        columns: [
            { label: "Manager", type: "text", strong: true },
            { label: "🏆", type: "num" },
            { label: "Yrs", type: "num" },
            { label: "W", type: "num" },
            { label: "L", type: "num" },
            { label: "Win %", type: "num" },
            { label: "PF", type: "num" },
            { label: "PA", type: "num" },
            { label: "PF Avg", type: "num" },
            { label: "PA Avg", type: "num" },
            { label: "Moves", type: "num" },
            { label: "Moves Avg", type: "num" }
        ],
        rows: standingsRows
    }, sortable=true, id='teamChart') }}
</div>
{% endblock %}
