{% extends 'base.njk' %}
{% from "_components/ui.njk" import pageHero, secHead, championCard %}

{% block title %}LLS Record Book 🏈 The Late Late Shift{% endblock %}

{% block content %}
{{ pageHero(
    "Hall of Records",
    intro="Champions, belts, and the records nobody wanted to set.",
    updated="8/27/26",
    image="https://embed-ssl.wistia.com/deliveries/d239f824fd904d470915c302228e208f.png",
    imageAlt="Photograph of the NFL Hall of Fame"
) }}

<div>
    {{ secHead("Championships") }}
    <div class="champ-grid">
        {% for season in league.seasons | reverse %}
        {{ championCard(season, ('/assets/images/championSymbol.svg' | url)) }}
        {% endfor %}
    </div>
</div>

<div>
    {{ secHead("Records — the good kind", color="blue") }}
    <div class="record-grid">
        {% for rec in records.positive %}
        <div class="record-tile">
            <img class="icon" src="{{ '/assets/images/champBeltGrad.svg' | url }}" alt="">
            <h3>{{ rec.title }}</h3>
            <div class="val">{{ rec.value }}</div>
            {% if rec.detail %}<div class="detail">{{ rec.detail }}</div>{% endif %}
            <div class="mgr">{{ rec.manager }}</div>
        </div>
        {% endfor %}
    </div>
</div>

<div>
    {{ secHead("Records — the other kind", color="red") }}
    <div class="record-grid">
        {% for rec in records.negative %}
        <div class="record-tile negative">
            <img class="icon" src="{{ '/assets/images/loserTrophyFill2.svg' | url }}" alt="">
            <h3>{{ rec.title }}</h3>
            <div class="val">{{ rec.value }}</div>
            {% if rec.detail %}<div class="detail">{{ rec.detail }}</div>{% endif %}
            <div class="mgr">{{ rec.manager }}</div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
