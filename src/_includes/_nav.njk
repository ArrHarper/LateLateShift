<nav class="site-nav" id="site-nav" aria-label="Main">
    <div class="container">
        <a class="nav-logo" href="{{ '/' | url }}">
            <img src="{{ '/assets/images/lls-logo-knockout.svg' | url }}" alt="The Late Late Shift — home">
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle navigation">☰</button>
        <div class="nav-links" id="nav-links">
            {% set navItems = [
                {url: '/', text: 'Home'},
                {url: '/teams/', text: 'Teams'},
                {url: '/rules/', text: 'Rules'},
                {url: '/keeper-history/', text: 'Keepers'},
                {url: '/recordBook/', text: 'Records'}
            ] %}
            {% for item in navItems %}
                <a href="{{ item.url | url }}"{% if item.url == page.url %} class="is-active" aria-current="page"{% endif %}>{{ item.text }}</a>
            {% endfor %}
        </div>
        <a class="nav-cta" href="{{ league.yahooEvergreenUrl }}" target="_blank" rel="noopener">League on Yahoo</a>
    </div>
</nav>
