{# Keeper Outlook + Back in the Pool — shared by the homepage and the keepers page.
   Set outlookShowHistoryLink = true before including to show the "Full history →" link. #}
{% from "_components/ui.njk" import secHead %}
{% from "_components/llsTable.njk" import llsTable %}
{% set latestKeepers = keepers.seasons | first %}
{% set nextYear = latestKeepers.year + 1 %}
<div>
    {{ secHead("Keeper Outlook " + ([nextYear] | shortYears), note="who can be kept again, and what it costs", link=(('/keeper-history/' | url) if outlookShowHistoryLink else ''), linkText="Full history →") }}
    {% set outlook = latestKeepers.rows | keeperOutlook %}
    <div class="split-main-rail outlook-grid">
        {% set outlookRows = [] %}
        {# default order: cheapest '26 keeps first, back-to-pool rows last #}
        {% set eligRows = outlook | selectattr("eligible") | sort(false, false, "nextCost") | list %}
        {% set poolRows = outlook | rejectattr("eligible") | list %}
        {% for k in eligRows.concat(poolRows) %}
            {% set _ = outlookRows.push([
                k.manager,
                k.player,
                k.pos | posBadge,
                k.cost,
                ("Rd " + k.nextCost) if k.eligible else "—",
                ('<span class="cell-ok">Eligible</span>' if k.eligible else '<span class="cell-out">Back to pool</span>')
            ]) %}
        {% endfor %}
        <div class="outlook-holder">
        {{ llsTable({
            columns: [
                { label: "Manager", type: "text", strong: true },
                { label: ([latestKeepers.year] | shortYears) + " Keeper", type: "text" },
                { label: "POS", type: "text" },
                { label: ([latestKeepers.year] | shortYears) + " Cost", type: "num", hideMobile: true },
                { label: ([nextYear] | shortYears) + " Cost", type: "num" },
                { label: "Status", type: "text" }
            ],
            rows: outlookRows
        }, sortable=true, id='keeper-outlook') }}
        </div>
        <div class="mod rank-mod">
            <div class="mod-head"><h3>Back in the Pool · {{ nextYear }}</h3></div>
            <ol>
                {% for k in outlook %}
                {% if not k.eligible %}
                <li>
                    {# portrait when we have one, initials otherwise #}
                    {% set shot = portraits[k.player] %}
                    <span class="face{% if not shot %} face-init{% endif %}">
                        {%- if shot %}<img src="{{ shot | url }}" alt="" loading="lazy" width="34" height="34">
                        {%- else %}{{ k.player | truncate(2, true, '') }}{% endif -%}
                    </span>
                    <span class="who"><b>{{ k.player }}</b><span>kept 2 yrs by {{ k.manager }}</span></span>
                    {{ k.pos | posBadge | safe }}
                </li>
                {% endif %}
                {% endfor %}
            </ol>
        </div>
    </div>
</div>
