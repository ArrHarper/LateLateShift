<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="The LLS Keeper League, Est 2020">
    <meta name="author" content="ArrHarper">
    <title>{% block title %}The Late Late Shift{% endblock %}</title>
    <link rel="icon" type="image/x-icon" href="{{ '/assets/favicon.ico' | url }}">
    <link rel="stylesheet" href="{{ '/css/fonts.css' | url }}">
    <link rel="stylesheet" href="{{ '/css/tokens.css' | url }}">
    <link rel="stylesheet" href="{{ '/css/site.css' | url }}">
    <script src="{{ '/js/lls-table.js' | url }}" defer></script>
    <script src="{{ '/js/nav.js' | url }}" defer></script>
    {% block head %}{% endblock %}
</head>
<body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TRWVV3VF"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a class="skip-link" href="#main">Skip to content</a>

    {% include "_nav.njk" %}

    <main id="main">
        <div class="container page-stack">
            {% block content %}{% endblock %}
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div>© ArrHarper {{ league.current.year }} · {{ league.name }} · Est. {{ league.est }}</div>
            <div><a href="{{ league.yahooEvergreenUrl }}">League on Yahoo</a> · <a href="{{ '/rules/' | url }}">Rules</a></div>
        </div>
    </footer>

    {% block scripts %}{% endblock %}
</body>
</html>
